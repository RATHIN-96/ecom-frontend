<div class="container my-5">

  <h2 class="mb-4 text-center">
    📦 My Orders
  </h2>
  
  <p>Tracking And Manage Your Orders</p>

  <div class="card shadow-sm mb-4" *ngFor="let order of orders">

    <div class="card-body">

      <!-- Header -->

      <div class="d-flex justify-content-between align-items-center">

        <div>

          <h5 class="mb-1">
            Order #{{ order.id }}
          </h5>

          <hr>

          <h5>
            Order Date
          </h5>

          <small class="text-muted">

            {{ order.created_at | date:'medium' }}

          </small>

        </div>

        <span
          class="badge bg-warning"
          *ngIf="order.status=='Pending'">

          Pending

        </span>

        <span
          class="badge bg-success"
          *ngIf="order.status=='Paid'">

          Paid

        </span>

        <span
          class="badge bg-primary"
          *ngIf="order.status=='Shipped'">

          Shipped

        </span>

        <span
          class="badge bg-info"
          *ngIf="order.status=='Delivered'">

          Delivered

        </span>

        <span
          class="badge bg-danger"
          *ngIf="order.status=='Cancelled'">

          Cancelled

        </span>

      </div>

      <hr>

      <!-- Timeline -->

      <h6 class="mb-3">
        📍 Order Progress
      </h6>

      <div class="d-flex justify-content-between align-items-center mb-4">

        <div class="text-center">

          <i
            class="bi bi-cart-check-fill fs-2"
            [class.text-success]="true">
          </i>

          <br>

          <small>Ordered</small>

        </div>

        <div class="flex-grow-1 border-top mx-2"></div>

        <div class="text-center">

          <i
            class="bi bi-credit-card-fill fs-2"
            [class.text-success]="order.payment_status=='Success'">
          </i>

          <br>

          <small>Paid</small>

        </div>

        <div class="flex-grow-1 border-top mx-2"></div>

        <div class="text-center">

          <i
            class="bi bi-truck fs-2"
            [class.text-success]="order.status=='Shipped' || order.status=='Delivered'">
          </i>

          <br>

          <small>Shipped</small>

        </div>

        <div class="flex-grow-1 border-top mx-2"></div>

        <div class="text-center">

          <i
            class="bi bi-box-seam-fill fs-2"
            [class.text-success]="order.status=='Delivered'">
          </i>

          <br>

          <small>Delivered</small>

        </div>

      </div>

      <hr>

      <!-- Payment -->

      <div class="row">

        <div class="col-md-6">

          <p>

            <strong>Payment Status :</strong>

            <span
              class="badge bg-success ms-2"
              *ngIf="order.payment_status=='Success'">

              Success

            </span>

            <span
              class="badge bg-warning ms-2"
              *ngIf="order.payment_status=='Pending'">

              Pending

            </span>

            <span
              class="badge bg-danger ms-2"
              *ngIf="order.payment_status=='Failed'">

              Failed

            </span>

          </p>

        </div>

        <div class="col-md-6">

          <p>

            <strong>Refund :</strong>

            <span
              class="badge bg-secondary ms-2"
              *ngIf="order.refund_status=='Not Applicable'">

              Not Applicable

            </span>

            <span
              class="badge bg-warning ms-2"
              *ngIf="order.refund_status=='Pending'">

              Pending

            </span>

            <span
              class="badge bg-success ms-2"
              *ngIf="order.refund_status=='Completed'">

              Completed

            </span>

          </p>

        </div>

      </div>

      <p *ngIf="order.payment_id">

        <strong>Payment ID :</strong>

        {{ order.payment_id }}

      </p>

      <h5 class="text-success">

        Total : ₹ {{ order.total_price }}

      </h5>

      <hr>

      <!-- Products -->

      <h5 class="mb-3">

        🛍 Ordered Products

      </h5>

      <div
        *ngFor="let item of order.items"
        class="row align-items-center border rounded p-3 mb-3">

        <div class="col-md-2 text-center">

          <img
            [src]="item.product.image"
            class="img-fluid rounded"
            style="height:100px;object-fit:cover;">

        </div>

        <div class="col-md-6">

          <h5>

            {{ item.product.name }}

          </h5>

          <p class="mb-1">

            Quantity :
            {{ item.quantity }}

          </p>

        </div>

        <div class="col-md-4 text-end">

          <h5 class="text-success">

            ₹ {{ item.price }}

          </h5>

        </div>

      </div>

      <!-- Buttons -->

      <div class="d-flex justify-content-end gap-2">

        <button
          class="btn btn-outline-danger"
          *ngIf="order.status=='Pending' || order.status=='Paid'"
          (click)="cancelOrder(order.id)">

          ❌ Cancel Order

        </button>

      </div>

    </div>

  </div>

</div>